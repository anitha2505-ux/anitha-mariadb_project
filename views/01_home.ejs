  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Footer year
    document.getElementById('pcYear').textContent = new Date().getFullYear();

    // Simple local cart counter (front-end demo)
    let pcCartCount = 0;
    const pcCartCountEl = document.getElementById('pcCartCount');
    function pcAddToCart(productName) {
      pcCartCount++;
      pcCartCountEl.textContent = pcCartCount;
      pcToast(`Added to cart: ${productName}`);
    }

    // Minimal toast (no dependency)
    function pcToast(message) {
      const el = document.createElement('div');
      el.className = 'pc-flash pc-flash-success';
      el.style.position = 'fixed';
      el.style.left = '18px';
      el.style.bottom = '18px';
      el.style.zIndex = '9999';
      el.innerHTML = `<div><strong>Done.</strong><div class="pc-muted-small">${message}</div></div>`;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 2200);
    }

    // Chatbot UI
    const pcChatPanel = document.getElementById('pcChatPanel');
    const pcChatBody = document.getElementById('pcChatBody');
    const pcChatInput = document.getElementById('pcChatInput');

    function pcToggleChat(open) {
      if (open) pcChatPanel.classList.add('open');
      else pcChatPanel.classList.remove('open');
      if (open) setTimeout(() => pcChatInput && pcChatInput.focus(), 50);
    }

    function pcAppendBubble(text, who) {
      const b = document.createElement('div');
      b.className = 'pc-bubble ' + (who === 'me' ? 'me' : 'bot');
      b.textContent = text;
      pcChatBody.appendChild(b);
      pcChatBody.scrollTop = pcChatBody.scrollHeight;
    }

    // AI auto response (rule-based starter; replace with real AI endpoint later)
    function pcBotReply(userTextRaw) {
      const t = (userTextRaw || '').toLowerCase();

      if (t.includes('book') || t.includes('appointment') || t.includes('groom')) {
        return 'You can book an appointment via “Book Appointment” or go to /bookings/new. If you tell me the service and date, I can guide you.';
      }
      if (t.includes('hour') || t.includes('open') || t.includes('closing')) {
        return 'Our standard opening hours are 10:00 AM to 8:00 PM daily. For holiday hours, please check your outlet page.';
      }
      if (t.includes('address') || t.includes('outlet') || t.includes('location')) {
        return 'We have outlets at Marsiling (730000), Lavender (330000), and Punggol (820000). Scroll to the Outlets section for maps and contact numbers.';
      }
      if (t.includes('delivery') || t.includes('shipping')) {
        return 'Shop delivery is available for selected items. If you share your postal code, we can confirm coverage.';
      }
      if (t.includes('refund') || t.includes('cancel') || t.includes('reschedule')) {
        return 'You may reschedule or cancel from your booking page. For same-day changes, please call the outlet directly.';
      }
      return 'Thank you. Please share your pet type (dog/cat), the service you want, and your preferred date/time.';
    }

    function pcSendChat(e) {
      e.preventDefault();
      const text = (pcChatInput.value || '').trim();
      if (!text) return;

      pcAppendBubble(text, 'me');
      pcChatInput.value = '';

      // Simulate response
      setTimeout(() => {
        pcAppendBubble(pcBotReply(text), 'bot');
      }, 400);
    }
  </script>
