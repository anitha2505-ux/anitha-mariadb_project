<!-- views/01_home.ejs -->
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PawfectCare | Home</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Fonts (Poppins + Nunito) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Poppins:wght@600;700;800&display=swap"
    rel="stylesheet">

  <!-- PawfectCare UI (paste your full CSS into /public/css/pawfectcare-ui.css) -->
  <link rel="stylesheet" href="/css/pawfectcare-ui.css">

  <style>
    /* Page-only helpers */
    .pc-page {
      min-height: 100vh;
    }

    .pc-hero-full {
      position: relative;
      min-height: calc(100vh - 72px);
      background:
        linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)),
        url("/images/Hero.jpg") center center / cover no-repeat;
      display: flex;
      align-items: center;
    }

    .pc-hero-logo-sticky {
      position: absolute;
      top: 18px;
      left: 18px;
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.6);
      display: grid;
      place-items: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
      z-index: 2;
    }

    .pc-hero-logo-sticky img {
      width: 40px;
      height: 40px;
      object-fit: contain;
    }

    .pc-overlay-card {
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    }

    .pc-section-pad {
      padding: 56px 0;
    }

    .pc-muted-small {
      color: var(--pc-muted);
      font-size: 13px;
    }

    .pc-price {
      font-family: var(--pc-font-h);
      font-weight: 800;
    }

    /* Chatbot */
    .pc-chatbot {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 9999;
    }

    .pc-chatbot-panel {
      width: 340px;
      max-width: calc(100vw - 36px);
      height: 420px;
      max-height: calc(100vh - 120px);
      display: none;
      overflow: hidden;
      border-radius: 18px;
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.20);
      border: 1px solid rgba(0, 0, 0, 0.08);
      background: #fff;
    }

    .pc-chatbot-panel.open {
      display: block;
    }

    .pc-chatbot-header {
      background: var(--pc-coral);
      color: #fff;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-family: var(--pc-font-h);
      font-weight: 800;
    }

    .pc-chatbot-body {
      padding: 12px 12px 0;
      height: 320px;
      overflow: auto;
      background: #fffdf9;
    }

    .pc-bubble {
      max-width: 84%;
      padding: 10px 12px;
      border-radius: 14px;
      margin: 8px 0;
      border: 1px solid rgba(0, 0, 0, 0.06);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.06);
      font-size: 14px;
      line-height: 1.35;
      background: #fff;
    }

    .pc-bubble.me {
      margin-left: auto;
      background: rgba(247, 181, 56, 0.16);
      border-color: rgba(247, 181, 56, 0.28);
    }

    .pc-bubble.bot {
      margin-right: auto;
      background: rgba(216, 87, 42, 0.10);
      border-color: rgba(216, 87, 42, 0.18);
    }

    .pc-chatbot-footer {
      padding: 10px 12px 12px;
      background: #fff;
      border-top: 1px solid rgba(0, 0, 0, 0.06);
    }

    .pc-chatbot-toggle {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      border: 1px solid rgba(0, 0, 0, 0.10);
      background: var(--pc-amber);
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.18);
      display: grid;
      place-items: center;
      cursor: pointer;
    }

    .pc-chatbot-toggle i {
      font-size: 22px;
      color: #4A3300;
    }
  </style>
</head>

<body class="pc-body pc-page">

  <!-- 2) Section 1: Hero Image (full screen) -->
  <header class="pc-hero-full">
    <!-- Logo image sticky on top of the Hero Image -->


    <div class="pc-hero-inner">
      <div class="pc-hero-logo" title="PawfectCare">
        <img src="/images/pawfectcare-logo.png" alt="PawfectCare logo" onerror="this.style.display='none'">
        <i class="bi bi-heart-fill text-danger" style="display:none"></i>
      </div>
      <div class="row g-4 align-items-center">
        <div class="col-lg-7 text-white">
          <h1 class="display-4 fw-bold">Happy pet care, near you.</h1>
          <h4 class="mt-3 fw-semibold" style="color: rgba(225, 172, 110, 0.92);">
            Grooming, daycare &amp; wellness, all in one cheerful place.
          </h4>

          <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary pc-hero-btn" href="/bookings/new">
              <i class="bi bi-calendar2-check me-2"></i>Book Appointment
            </a>
            <a class="btn btn-secondary pc-hero-btn" href="/services">
              <i class="bi bi-grid me-2"></i>Explore Services
            </a>
          </div>

          <div class="mt-3 pc-muted-small" style="color: rgba(255,255,255,0.85);">
            Trusted care. Friendly staff. Simple booking.
          </div>
        </div>

        <div class="col-lg-5">
          <div class="pc-overlay-card p-3 p-md-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <strong style="font-family: var(--pc-font-h);">Quick Booking</strong>
            </div>

            <form class="row g-2" method="GET" action="/search">
              <div class="col-12">
                <label class="form-label">Service</label>
                <select class="form-select" name="serviceId">
                  <option value="">Any service</option>
                  <% if (typeof services !=="undefined" && services && services.length) { %>
                    <% services.forEach(s=> { %>
                      <option value="<%= s.serviceId %>">
                        <%= s.serviceName %>
                      </option>
                      <% }) %>
                        <% } else { %>
                          <option value="1">Grooming</option>
                          <option value="2">Training</option>
                          <option value="3">Boarding</option>
                          <option value="4">Transport</option>
                          <% } %>
                </select>
              </div>

              <div class="col-6">
                <label class="form-label">From</label>
                <input class="form-control" type="date" name="dateFrom">
              </div>

              <div class="col-6">
                <label class="form-label">To</label>
                <input class="form-control" type="date" name="dateTo">
              </div>

              <div class="col-12">
                <label class="form-label">Owner Email (optional)</label>
                <input class="form-control" type="email" name="ownerEmail" placeholder="name@email.com">
              </div>

              <div class="col-12 d-grid mt-2">
                <button class="btn btn-success" type="submit">
                  <i class="bi bi-search me-2"></i>Find Availability
                </button>
              </div>


            </form>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- 3) Section 2: Services -->
  <section class="pc-section-pad">
    <div class="container">
      <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-3">
        <div>
          <h2 class="pc-section-title mb-1">Services</h2>
          <div class="pc-muted">Your pet’s happy place starts here.</div>
        </div>
        <a class="btn btn-outline-primary" href="/services">
          View all services <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>

      <div class="row g-3">
        <div class="col-md-6 col-lg-3">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <img src="/images/services-grooming.jpg" class="img-fluid rounded-4 mb-3" alt="Grooming"
                onerror="this.style.display='none'">
              <h5 class="mb-2">Grooming Services</h5>
              <p class="pc-muted mb-3">Bath, cut, nail trim, and tidy-ups for a fresh, confident look.</p>
              <a href="/services#grooming" class="btn btn-sm btn-primary">Read more</a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <img src="/images/services-training.jpg" class="img-fluid rounded-4 mb-3" alt="Training"
                onerror="this.style.display='none'">
              <h5 class="mb-2">Training Services</h5>
              <p class="pc-muted mb-3">Positive reinforcement training for confident, well-mannered pets.</p>
              <a href="/services#training" class="btn btn-sm btn-primary">Read more</a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <img src="/images/services-boarding.jpg" class="img-fluid rounded-4 mb-3" alt="Boarding"
                onerror="this.style.display='none'">
              <h5 class="mb-2">Boarding Services</h5>
              <p class="pc-muted mb-3">Safe, cozy stays with supervised play and daily wellbeing checks.</p>
              <a href="/services#boarding" class="btn btn-sm btn-primary">Read more</a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <img src="/images/services-transport.jpg" class="img-fluid rounded-4 mb-3" alt="Transport"
                onerror="this.style.display='none'">
              <h5 class="mb-2">Transport Services</h5>
              <p class="pc-muted mb-3">Door-to-door pick-up and drop-off for appointments and daycare.</p>
              <a href="/services#transport" class="btn btn-sm btn-primary">Read more</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4) Section 3: Products (carousel) -->
  <section class="pc-section-pad" style="background: rgba(247,181,56,0.08);">
    <div class="container">
      <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-3">
        <div>
          <h2 class="pc-section-title mb-1">Products</h2>
          <div class="pc-muted">Everyday essentials for happy tails.</div>
        </div>
        <a class="btn btn-outline-primary" href="/shop">
          Visit shop <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>

      <div id="pcProducts" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
          <button type="button" data-bs-target="#pcProducts" data-bs-slide-to="0" class="active"></button>
          <button type="button" data-bs-target="#pcProducts" data-bs-slide-to="1"></button>
        </div>

        <div class="carousel-inner">
          <!-- Slide 1 -->
          <div class="carousel-item active">
            <div class="row g-3">
              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-shampoo.jpg" class="img-fluid rounded-4 mb-3" alt="Shampoo"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Gentle Oat Shampoo</h6>
                    <div class="pc-muted mb-2">Sensitive-skin friendly</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$18.90</span>
                      <button class="btn btn-sm btn-success" type="button" onclick="pcAddToCart('Gentle Oat Shampoo')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-treats.jpg" class="img-fluid rounded-4 mb-3" alt="Treats"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Training Treat Bites</h6>
                    <div class="pc-muted mb-2">Reward-ready</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$12.50</span>
                      <button class="btn btn-sm btn-success" type="button"
                        onclick="pcAddToCart('Training Treat Bites')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-6.jpg" class="img-fluid rounded-4 mb-3" alt="Leash"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Comfort Leash</h6>
                    <div class="pc-muted mb-2">Soft grip, strong hold</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$24.90</span>
                      <button class="btn btn-sm btn-success" type="button" onclick="pcAddToCart('Comfort Leash')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-5.jpg" class="img-fluid rounded-4 mb-3" alt="Toy"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Chew Toy Duo</h6>
                    <div class="pc-muted mb-2">Durable fun</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$16.00</span>
                      <button class="btn btn-sm btn-success" type="button" onclick="pcAddToCart('Chew Toy Duo')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 2 -->
          <div class="carousel-item">
            <div class="row g-3">
              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-3.jpg" class="img-fluid rounded-4 mb-3" alt="Vitamins"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Wellness Chews</h6>
                    <div class="pc-muted mb-2">Daily support</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$29.90</span>
                      <button class="btn btn-sm btn-success" type="button" onclick="pcAddToCart('Wellness Chews')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-4.jpg" class="img-fluid rounded-4 mb-3" alt="Bowl"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Non-slip Bowl</h6>
                    <div class="pc-muted mb-2">Easy clean</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$14.90</span>
                      <button class="btn btn-sm btn-success" type="button" onclick="pcAddToCart('Non-slip Bowl')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-5.jpg" class="img-fluid rounded-4 mb-3" alt="Brush"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Grooming Brush</h6>
                    <div class="pc-muted mb-2">Smooth coat</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$19.90</span>
                      <button class="btn btn-sm btn-success" type="button" onclick="pcAddToCart('Grooming Brush')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-3">
                <div class="pc-card h-100">
                  <div class="pc-card-body">
                    <img src="/images/prod-6.jpg" class="img-fluid rounded-4 mb-3" alt="Bed"
                      onerror="this.style.display='none'">
                    <h6 class="mb-1">Cozy Pet Bed</h6>
                    <div class="pc-muted mb-2">Nap-approved</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="pc-price">$39.90</span>
                      <button class="btn btn-sm btn-success" type="button" onclick="pcAddToCart('Cozy Pet Bed')">
                        <i class="bi bi-bag-plus"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#pcProducts" data-bs-slide="prev">
          <span class="carousel-control-prev-icon"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#pcProducts" data-bs-slide="next">
          <span class="carousel-control-next-icon"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 5) Section 4: Outlets -->
  <section class="pc-section-pad">
    <div class="container">
      <div class="mb-3">
        <h2 class="pc-section-title mb-1">Outlets</h2>
        <div class="pc-muted">Three convenient locations across Singapore.</div>
      </div>

      <div class="row g-3">
        <!-- Marsiling -->
        <div class="col-lg-4">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <div class="d-flex gap-2 align-items-start">
                <i class="bi bi-geo-alt-fill fs-5" style="color: var(--pc-coral);"></i>
                <div>
                  <h5 class="mb-1">Marsiling</h5>
                  <img src="/images/marsiling.jpg" class="img-fluid rounded-4 mb-3" alt="marsiling"
                    onerror="this.style.display='none'">
                </div>
              </div>

              <div class="mt-3 pc-muted">
                18 Pet Care Street, #02-01, Singapore 730000<br>
                +65 6123 4567
              </div>

              <div class="ratio ratio-16x9 mt-3 rounded-4 overflow-hidden border">
                <!-- OpenStreetMap embed (no API key) -->
                <iframe
                  src="https://www.openstreetmap.org/export/embed.html?bbox=103.770%2C1.430%2C103.785%2C1.442&layer=mapnik"
                  loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                </iframe>
              </div>
            </div>
          </div>
        </div>

        <!-- Lavender -->
        <div class="col-lg-4">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <div class="d-flex gap-2 align-items-start">
                <i class="bi bi-geo-alt-fill fs-5" style="color: var(--pc-coral);"></i>
                <div>
                  <h5 class="mb-1">Lavender</h5>
                  <img src="/images/lavendar.jpg" class="img-fluid rounded-4 mb-3" alt="lavendar"
                    onerror="this.style.display='none'">
                </div>
              </div>

              <div class="mt-3 pc-muted">
                77 Wellness Lane, #01-08, Singapore 330000<br>
                +65 6234 5678
              </div>

              <div class="ratio ratio-16x9 mt-3 rounded-4 overflow-hidden border">
                <iframe
                  src="https://www.openstreetmap.org/export/embed.html?bbox=103.856%2C1.302%2C103.871%2C1.314&layer=mapnik"
                  loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                </iframe>
              </div>
            </div>
          </div>
        </div>

        <!-- Punggol -->
        <div class="col-lg-4">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <div class="d-flex gap-2 align-items-start">
                <i class="bi bi-geo-alt-fill fs-5" style="color: var(--pc-coral);"></i>
                <div>
                  <h5 class="mb-1">Punggol</h5>
                  <img src="/images/punggol.jpg" class="img-fluid rounded-4 mb-3" alt="punggol"
                    onerror="this.style.display='none'">
                </div>
              </div>

              <div class="mt-3 pc-muted">
                5 Happy Paw Walk, #03-12, Singapore 820000<br>
                +65 6345 6789
              </div>

              <div class="ratio ratio-16x9 mt-3 rounded-4 overflow-hidden border">
                <iframe
                  src="https://www.openstreetmap.org/export/embed.html?bbox=103.902%2C1.398%2C103.918%2C1.410&layer=mapnik"
                  loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                </iframe>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 6) Section 5: Newsletter Subscription -->
  <section class="pc-section-pad" style="background: rgba(216,87,42,0.06);">
    <div class="container">
      <div class="row g-3 align-items-center">
        <div class="col-lg-6">
          <h2 class="pc-section-title mb-1">Newsletter</h2>
          <div class="pc-muted">Get promos, new services, and event updates—no spam, only pawsitivity.</div>
        </div>
        <div class="col-lg-6">
          <form class="pc-card p-3 p-md-4" method="POST" action="/newsletter">
            <label class="form-label">Email Address</label>
            <div class="input-group">
              <input type="email" class="form-control" name="email" placeholder="you@email.com" required>
              <button class="btn btn-primary" type="submit">
                Subscribe <i class="bi bi-arrow-right ms-1"></i>
              </button>
            </div>
            <div class="pc-muted-small mt-2">You can unsubscribe anytime.</div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 7) Section 6: Events -->
  <section class="pc-section-pad">
    <div class="container">
      <div class="mb-3">
        <h2 class="pc-section-title mb-1">Events</h2>
        <div class="pc-muted">Join our upcoming community events.</div>
      </div>

      <div class="row g-3">
        <div class="col-md-6 col-lg-4">
          <div class="pc-card h-100">
            <div class="pc-card-body">
              <h5 class="mb-2">Pawfect Adoption Day</h5>
              <img src="/images/adoption.jpg" class="img-fluid rounded-4 mb-3" alt="adoption"
                onerror="this.style.display='none'">
