<!-- views/11_services_index.ejs -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h4 mb-0">Services</h2>
</div>

<div class="card shadow-sm rounded-4">
  <div class="card-body">
    <% if (!services || services.length === 0) { %>
      <div class="text-muted">No services found.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Service ID</th>
              <th>Service Name</th>
              <th>Service Type</th>
              <th>Price S$</th>
              <th>Duration (Min)</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <% services.forEach(s => { %>
              <tr>
                <td><%= s.serviceId %></td>
                <td class="fw-semibold"><%= s.serviceName %></td>
                <td><span class="badge text-bg-secondary"><%= s.serviceType %></span></td>
                <td>$<%= Number(s.price).toFixed(2) %></td>
                <td><%= s.durationMinutes %></td>
                <td class="text-muted"><%= s.description || "-" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
