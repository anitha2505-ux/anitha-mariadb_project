<!-- views/05_bookings_index.ejs -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h2 class="h4 mb-0">Bookings</h2>
  <a class="btn btn-success" href="/bookings/new">+ Add New Booking</a>
</div>

<div class="card shadow-sm rounded-4">
  <div class="card-body">
    <% if (!bookings || bookings.length===0) { %>
      <div class="text-muted">No bookings found.</div>
      <% } else { %>
        <div class="table-responsive">
          <% if (flashMessage) { %>
            <div class="alert alert-success">
              <%= flashMessage %>
            </div>
            <% } %>

              <form method="GET" action="/bookings" class="row g-2 mb-3">

                <div class="col-md-2">
                  <label class="form-label">Status</label>
                  <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="Pending" <%=filters?.status==="Pending" ? "selected" : "" %>>Pending</option>
                    <option value="Confirmed" <%=filters?.status==="Confirmed" ? "selected" : "" %>>Confirmed</option>
                    <option value="Cancelled" <%=filters?.status==="Cancelled" ? "selected" : "" %>>Cancelled</option>
                  </select>
                </div>

                <div class="col-md-2">
                  <label class="form-label">Date From</label>
                  <input type="date" name="dateFrom" class="form-control" value="<%= filters?.dateFrom || '' %>">
                </div>

                <div class="col-md-2">
                  <label class="form-label">Date To</label>
                  <input type="date" name="dateTo" class="form-control" value="<%= filters?.dateTo || '' %>">
                </div>

                <div class="col-md-3">
                  <label class="form-label">Owner Email</label>
                  <input type="text" name="ownerEmail" class="form-control" placeholder="e.g. gmail"
                    value="<%= filters?.ownerEmail || '' %>">
                </div>

                <div class="col-md-3">
                  <label class="form-label">Service</label>
                  <select name="serviceId" class="form-select">
                    <option value="">All</option>
                    <% (services || []).forEach(s=> { %>
                      <option value="<%= s.serviceId %>" <%=String(filters?.serviceId || "" )===String(s.serviceId)
                        ? "selected" : "" %>>
                        <%= s.serviceName %>
                      </option>
                      <% }) %>
                  </select>
                </div>

                <div class="col-12 d-flex gap-2 mt-2">
                  <button type="submit" class="btn btn-primary">Search</button>
                  <a href="/bookings" class="btn btn-secondary">Reset</a>
                </div>

              </form>



              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Booking ID</th>
                    <th>Date</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Services</th>
                    <th>Status</th>
                    <th>Owner First Name</th>
                    <th>Owner Last Name</th>
                    <th>Pet Name</th>
                    <th>Species</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% bookings.forEach(b=> { %>
                    <tr>
                      <td>
                        <%= b.bookingId %>
                      </td>
                      <td>
                        <%= b.bookingDate ? String(b.bookingDate).slice(0,10) : "-" %>
                      </td>
                      <td>
                        <%= b.startTime %>
                      </td>
                      <td>
                        <%= b.endTime %>
                      </td>
                      <td>
                        <%= b.serviceNames ? b.serviceNames : "No Service" %>
                      </td>
                      <td><span class="badge text-bg-secondary text-dark">
                          <%= b.status %>
                        </span></td>
                      <td>
                        <%= b.ownerFirstName %>
                      </td>
                      <td>
                        <%= b.ownerLastName %>
                      </td>
                      <td>
                        <%= b.petName %>
                      </td>
                      <td>
                        <%= b.species %>
                      </td>
                      <td>
                        <%= b.ownerEmail %>
                      </td>
                      <td>
                        <%= b.ownerPhone %>
                      </td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/bookings/<%= b.bookingId %>/edit">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" href="/bookings/<%= b.bookingId %>/delete">Delete</a>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
        </div>
        <% } %>
  </div>
</div>