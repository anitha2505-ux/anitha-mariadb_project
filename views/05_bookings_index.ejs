<!-- views/05_bookings_index.ejs -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h2 class="h4 mb-0">Bookings</h2>
  <a class="btn btn-success" href="/bookings/new">+ Add New Booking</a>
</div>

<div class="card shadow-sm rounded-4">
  <div class="card-body">
    <% if (!bookings || bookings.length===0) { %>
      <div class="text-muted">No bookings found.</div>
      <% } else { %>
        <div class="table-responsive">
          <% if (flashMessage) { %>
            <div class="alert alert-success">
              <%= flashMessage %>
            </div>
            <% } %>
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Booking ID</th>
                    <th>Date</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Service</th>
                    <th>Status</th>
                    <th>Owner First Name</th>
                    <th>Owner Last Name</th>
                    <th>Pet Name</th>
                    <th>Species</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% bookings.forEach(b=> { %>
                    <tr>
                      <td>
                        <%= b.bookingId %>
                      </td>
                      <td>
                        <%= b.bookingDate ? String(b.bookingDate).slice(0,10) : "-" %>
                      </td>
                      <td>
                        <%= b.startTime %>
                      </td>
                      <td>
                        <%= b.endTime %>
                      </td>
                      <td>
                        <%= b.serviceName ? b.serviceName : "No Service" %>
                      </td>
                      <td><span class="badge text-bg-secondary text-dark">
                          <%= b.status %>
                        </span></td>
                      <td>
                        <%= b.ownerFirstName %>
                      </td>
                      <td>
                        <%= b.ownerLastName %>
                      </td>
                      <td>
                        <%= b.petName %>
                      </td>
                      <td>
                        <%= b.species %>
                      </td>
                      <td>
                        <%= b.ownerEmail %>
                      </td>
                      <td>
                        <%= b.ownerPhone %>
                      </td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/bookings/<%= b.bookingId %>/edit">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" href="/bookings/<%= b.bookingId %>/delete">Delete</a>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
        </div>
        <% } %>
  </div>
</div>