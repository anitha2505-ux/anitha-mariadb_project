<!-- views/05_bookings_index.ejs -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h2 class="h4 mb-0">Bookings</h2>
  <a class="btn btn-success" href="/bookings/new">+ Add New Booking</a>
</div>

<div class="card shadow-sm rounded-4">
  <div class="card-body">
    <% if (!bookings || bookings.length === 0) { %>
      <div class="text-muted">No bookings found.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>bookingId</th>
              <th>bookingDate</th>
              <th>startTime</th>
              <th>endTime</th>
              <th>status</th>
              <th>ownerId</th>
              <th>petId</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(b => { %>
              <tr>
                <td><%= b.bookingId %></td>
                <td><%= b.bookingDate ? String(b.bookingDate).slice(0,10) : "-" %></td>
                <td><%= b.startTime %></td>
                <td><%= b.endTime %></td>
                <td><span class="badge text-bg-secondary"><%= b.status %></span></td>
                <td><%= b.ownerId %></td>
                <td><%= b.petId %></td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-primary" href="/bookings/<%= b.bookingId %>/edit">Edit</a>
                  <a class="btn btn-sm btn-outline-danger" href="/bookings/<%= b.bookingId %>/delete">Delete</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>


