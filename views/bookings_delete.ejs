<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Delete Booking</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <div class="container mt-4">
    <h3 class="text-danger mb-3">Confirm Delete Booking</h3>

    <div class="alert alert-warning">
      Are you sure you want to delete booking <strong>#<%= booking.bookingId %></strong>?
      This action cannot be undone.
    </div>

    <ul class="list-group mb-3">
      <li class="list-group-item"><strong>Date:</strong> <%= String(booking.bookingDate).slice(0,10) %></li>
      <li class="list-group-item"><strong>Time:</strong> <%= booking.startTime %> - <%= booking.endTime %></li>
      <li class="list-group-item"><strong>Owner:</strong> <%= booking.ownerFirstName %> <%= booking.ownerLastName %></li>
      <li class="list-group-item"><strong>Pet:</strong> <%= booking.petName %> (<%= booking.species %>)</li>
      <li class="list-group-item"><strong>Status:</strong> <%= booking.status %></li>
    </ul>

    <form method="POST" action="/bookings/<%= booking.bookingId %>/delete" class="d-flex gap-2">
      <button type="submit" class="btn btn-danger">Yes, Delete</button>
      <a href="/bookings" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</body>
</html>
