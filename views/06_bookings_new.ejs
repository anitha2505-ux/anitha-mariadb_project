<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add New Booking</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <div class="container mt-4">

    <% 
      // FIX B: Prevent crash if services is not passed from route
      const servicesList = (typeof services !== 'undefined') ? services : [];
    %>

    <h3 class="mb-3">Add New Booking</h3>

    <form method="POST" action="/bookings/create">

      <!-- Booking Date -->
      <div class="mb-3">
        <label class="form-label">Booking Date *</label>
        <input type="date" name="bookingDate" class="form-control" required>
      </div>

      <!-- Pet Details (PetID assigned by system) -->
      <h5 class="mt-4">Pet Details</h5>

      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Pet Name *</label>
          <input type="text" name="petName" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Species *</label>
          <input type="text" name="species" class="form-control" required>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Date of Birth (Optional)</label>
        <input type="date" name="dateOfBirth" class="form-control">
      </div>

      <!-- Owner Details -->
      <h5 class="mt-4">Owner Details</h5>

      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Owner First Name *</label>
          <input type="text" name="ownerFirstName" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Owner Last Name *</label>
          <input type="text" name="ownerLastName" class="form-control" required>
        </div>
      </div>

      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Owner Email *</label>
          <input type="email" name="ownerEmail" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Owner Phone *</label>
          <input type="text" name="ownerPhone" class="form-control" required>
        </div>
      </div>

      <!-- Booking Time -->
      <h5 class="mt-4">Booking Time</h5>

      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Start Time *</label>
          <input type="time" name="startTime" class="form-control" step="1800" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">End Time</label>
          <input type="time" name="endTime" class="form-control" step="1800">
        </div>
      </div>

      <!-- Services (Multiple Checklist) -->
      <h5 class="mt-4">Services *</h5>

      <div class="mb-3">
        <% if (servicesList.length === 0) { %>
          <div class="alert alert-warning mb-0">
            No services available. Please add services in the Services table first.
          </div>
        <% } else { %>
          <div class="border rounded p-3">
            <% servicesList.forEach((s, index) => { %>
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="serviceIds[]"
                  id="service_<%= s.serviceId %>"
                  value="<%= s.serviceId %>"
                 >
                <label class="form-check-label" for="service_<%= s.serviceId %>">
                  <%= s.serviceName %>
                </label>
              </div>
            <% }) %>
          </div>
          <div class="form-text">
            Select one or more services.
          </div>
        <% } %>
      </div>

      <!-- Status -->
      <div class="mb-3">
        <label class="form-label">Status *</label>
        <select name="status" class="form-select" required>
          <option value="">Select Status</option>
          <option value="Pending">Pending</option>
          <option value="Confirmed">Confirmed</option>
          <option value="Cancelled">Cancelled</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">Create Booking</button>
      <a href="/bookings" class="btn btn-secondary">Cancel</a>

    </form>

  </div>
</body>
</html>
