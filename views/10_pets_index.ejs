<!-- views/10_pets_index.ejs -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h4 mb-0">Pets</h2>
</div>

<div class="card shadow-sm rounded-4">
  <div class="card-body">
    <% if (!pets || pets.length === 0) { %>
      <div class="text-muted">No pets found.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>petId</th>
              <th>petName</th>
              <th>species</th>
              <th>dateOfBirth</th>
              <th>ownerId</th>
            </tr>
          </thead>
          <tbody>
            <% pets.forEach(p => { %>
              <tr>
                <td><%= p.petId %></td>
                <td class="fw-semibold"><%= p.petName %></td>
                <td><%= p.species %></td>
                <td><%= p.dateOfBirth ? String(p.dateOfBirth).slice(0,10) : "-" %></td>
                <td><%= p.ownerId %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
