<!-- views/07_bookings_edit.ejs -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h4 mb-0">Edit Booking #<%= booking.bookingId %></h2>
  <a class="btn btn-outline-secondary" href="/bookings">Back</a>
</div>

<div class="card shadow-sm rounded-4">
  <div class="card-body">
    <form method="POST" action="/bookings/<%= booking.bookingId %>">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">bookingDate</label>
          <input class="form-control" type="date" name="bookingDate"
                 value="<%= booking.bookingDate ? String(booking.bookingDate).slice(0,10) : "" %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">startTime</label>
          <input class="form-control" type="time" name="startTime" value="<%= booking.startTime %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">endTime</label>
          <input class="form-control" type="time" name="endTime" value="<%= booking.endTime %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">status</label>
          <select class="form-select" name="status" required>
            <% ["Pending","Confirmed","Completed","Cancelled"].forEach(s => { %>
              <option value="<%= s %>" <%= booking.status === s ? "selected" : "" %>><%= s %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">ownerId</label>
          <input class="form-control" type="number" name="ownerId" min="1" value="<%= booking.ownerId %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">petId</label>
          <input class="form-control" type="number" name="petId" min="1" value="<%= booking.petId %>" required>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit">Save Changes</button>
        <a class="btn btn-outline-secondary" href="/bookings">Cancel</a>
      </div>
    </form>
  </div>
</div>
