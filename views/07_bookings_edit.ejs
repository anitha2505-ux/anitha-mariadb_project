<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Edit Booking</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <div class="container mt-4">
    <h3 class="mb-3">Edit Booking #<%= booking.bookingId %>
    </h3>

    <form method="POST" action="/bookings/<%= booking.bookingId %>/update">

      <input type="date" name="bookingDate" class="form-control"
        value="<%= booking.bookingDate ? new Date(booking.bookingDate).toISOString().slice(0,10) : '' %>" required>

      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Start Time *</label>
          <input type="time" name="startTime" class="form-control" value="<%= booking.startTime %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">End Time *</label>
          <input type="time" name="endTime" class="form-control" value="<%= booking.endTime %>" required>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Status *</label>
        <select name="status" class="form-select" required>
          <option value="Pending" <%=booking.status==="Pending" ? "selected" : "" %>>Pending</option>
          <option value="Confirmed" <%=booking.status==="Confirmed" ? "selected" : "" %>>Confirmed</option>
          <option value="Cancelled" <%=booking.status==="Cancelled" ? "selected" : "" %>>Cancelled</option>
        </select>
      </div>

      <hr class="my-4">

      <h5>Pet Details</h5>
      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Pet Name *</label>
          <input type="text" name="petName" class="form-control" value="<%= booking.petName %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Species *</label>
          <input type="text" name="species" class="form-control" value="<%= booking.species %>" required>
        </div>
      </div>

      <h5>Owner Details</h5>
      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Owner First Name *</label>
          <input type="text" name="ownerFirstName" class="form-control" value="<%= booking.ownerFirstName %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Owner Last Name *</label>
          <input type="text" name="ownerLastName" class="form-control" value="<%= booking.ownerLastName %>" required>
        </div>
      </div>

      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label">Owner Email *</label>
          <input type="email" name="ownerEmail" class="form-control" value="<%= booking.ownerEmail %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Owner Phone *</label>
          <input type="text" name="ownerPhone" class="form-control" value="<%= booking.ownerPhone %>" required>
        </div>
      </div>

      <hr class="my-4">

      <h5>Services *</h5>
      <div class="mb-3 border rounded p-3">
        <% services.forEach((s, index)=> { %>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="serviceIds[]" id="service_<%= s.serviceId %>"
              value="<%= s.serviceId %>" <%=selectedServiceIds.includes(s.serviceId) ? "checked" : "" %>
            
              >
              <label class="form-check-label" for="service_<%= s.serviceId %>">
                <%= s.serviceName %>
              </label>
          </div>
          <% }) %>
      </div>

      <button type="submit" class="btn btn-primary">Update Booking</button>
      <a href="/bookings" class="btn btn-secondary">Cancel</a>

    </form>
  </div>
</body>

</html>